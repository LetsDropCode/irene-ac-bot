          {
            "type": "TextBody",
            "text": "${data.error}"
          },
          {
            "type": "TextBody",
            "text": "${data.summary}"
          },
          {
            "type": "OptIn",
            "name": "confirm",
            "label": "I confirm these details",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Confirm and save",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "revision": "${data.revision}",
                "confirm": "${form.confirm}"
              }
            }
          }
        ]
      }
